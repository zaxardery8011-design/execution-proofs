{
  "name": "execution-proofs",
  "version": "0.1.0",
  "description": "Runtime artifact existence and freshness verification for AI agent completion claims.",
  "type": "module",
  "bin": {
    "execution-proofs": "./dist/server.js"
  },
  "main": "./dist-cjs/src/core.js",
  "module": "./dist/src/core.js",
  "types": "./dist/src/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/core.d.ts",
      "import": "./dist/src/core.js",
      "require": "./dist-cjs/src/core.js"
    }
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.cjs",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "files": [
    "dist",
    "dist-cjs",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true
}
